# Salinan env — US Stock Volume Analyzer (Modul 15). Salin ke `.env`.
# digabungkan oleh docker-compose & pakai env di container (lihat docker-compose.yml).

# ==== Database (Modul 15.1) ====
# sqlite (default dev) | mysql | pgsql
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=stock_analyzer
DB_USER=stock
DB_PASSWORD=ganti_ini
DB_ROOT_PASSWORD=ganti_root
# Aktifkan schema cache di produksi
DB_SCHEMA_CACHE=1

# ==== Queue (Modul 15.3) ====
# sync (dev) | redis (produksi, butuh service redis) | file
QUEUE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CHANNEL=queue

# ==== Market data provider (Modul 2.3) ====
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=

# ==== Monitoring (Modul 15.5) ====
# Set ke alamat email untuk menerima notifikasi error via mailer.
ERROR_ALERT_EMAIL=ops@example.com